# Curator desk. Used by the Vercel server. Restart local `npm run dev` after changing these.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional. A long random string that signs the curator session. If empty, the password signs it.
ADMIN_SESSION_SECRET=

# Supabase holds journeys, dictionary changes, recipes, review queues and photographs.
# Use the service role on the server only. Never put it in a VITE_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public website read access. Use the anon key. Vercel includes these in the site build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# On Vercel, omit a variable that should be blank. Do not save a space.
# Leave VITE_ARCHIVE_API_URL unset when the website and the API share one Vercel project.
# Set SITE_URL to the production address, including https://, when you want canonical links.
ARCHIVE_SITE_URL=
ARCHIVE_ALLOWED_ORIGINS=
SITE_URL=

# The community register saves to Supabase whenever the service role is set.
# Set this to false to close the form.
ARCHIVE_SUBMISSIONS_ENABLED=
SUPABASE_INGEST_URL=
ARCHIVE_INGEST_KEY=
# Leave these unset to accept photographs and pronunciations whenever Supabase is configured.
# Set either one to false to close that form.
ARCHIVE_PHOTOS_ENABLED=
ARCHIVE_RECORDINGS_ENABLED=
SUPABASE_PRIVATE_BUCKET=
